# Port the service listens on
PORT=9991
HOST=0.0.0.0
# Where the database, uploaded files and update artifacts are stored
DATA_DIR=./data
# Comma-separated device tokens used by the desktop/mobile apps for sync.
# Generate with: openssl rand -hex 32
AZIM_TOKENS=change-me
# Token used by CI to publish new releases (keep secret)
AZIM_ADMIN_TOKEN=change-me-too
