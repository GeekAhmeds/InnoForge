# systemd unit for running the server without Docker.
# Install: sudo cp deploy/azim-command.service /etc/systemd/system/ && sudo systemctl enable --now azim-command
[Unit]
Description=Azim Command server
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/azim-command/apps/server
EnvironmentFile=/opt/azim-command/apps/server/.env
ExecStart=/usr/bin/node dist/index.js
Restart=always
RestartSec=3
User=azim

[Install]
WantedBy=multi-user.target
