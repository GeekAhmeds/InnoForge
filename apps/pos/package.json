{
  "name": "innoforge-pos",
  "productName": "InnoForge POS",
  "version": "0.1.0",
  "description": "Offline desktop point-of-sale for shops, bookstores and restaurants.",
  "author": "Inno Source",
  "license": "MIT",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "vite build",
    "start": "vite build && electron .",
    "test": "node --test --disable-warning=ExperimentalWarning test/*.test.cjs",
    "dist": "node scripts/package.cjs",
    "dist:win": "node scripts/package.cjs --win",
    "dist:mac": "node scripts/package.cjs --mac",
    "dist:linux": "node scripts/package.cjs --linux",
    "license": "node tools/license.cjs"
  },
  "build": {
    "appId": "io.innosource.innoforge.pos",
    "productName": "InnoForge POS",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "InnoForge POS",
      "artifactName": "InnoForge-POS-Setup-${version}.${ext}",
      "installerLanguages": [
        "ar_SA",
        "en_US"
      ],
      "language": "1025",
      "multiLanguageInstaller": true
    },
    "asar": true,
    "electronVersion": "44.7.0",
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    }
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "javascript-obfuscator": "^5.9.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^8.3.4",
    "wait-on": "^9.5.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/GeekAhmeds/InnoForge"
  }
}
