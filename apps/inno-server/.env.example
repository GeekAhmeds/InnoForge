# Inno Server — Inno Source For Software Solutions
PORT=9991
HOST=0.0.0.0
DATA_DIR=./data
# Products hosted on this server (each one is isolated: data, users, updates)
INNO_APPS=azim-command
# Owner tokens (full access to every app). Generate: openssl rand -hex 32
INNO_OWNER_TOKENS=change-me
# Token used by CI to publish new app versions
INNO_PUBLISH_TOKEN=change-me-too
